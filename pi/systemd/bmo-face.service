# bmo-face — la faccia di BMO sul Pi (issue #63; dal #79 sul display SPI ILI9341, con il HAT audio montato).
#
# Installazione (da `deploy.sh`, issue #16):
#   sudo cp bmo-face.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bmo-face.service
#
# §6.1 del piano: "la faccia deve accendersi prima che la rete sia pronta".
# Per questo niente `After=network...target` qui: `multi-user.target` da
# solo non aspetta la rete, e l'ordine coi servizi di rete non viene toccato.
# `Before=bmo-core.service` fa sì che la faccia sia già in piedi (stato
# "assonnato") quando bmo-core (issue #16) prova ad aprire il socket.
[Unit]
Description=bmo-face - faccia di BMO (pannello sul display SPI)
Before=bmo-core.service

[Service]
Type=simple
User=clanker_home
WorkingDirectory=/home/clanker_home/bmo-pi/bmo-diy/bmo-face
Environment=PYTHONPATH=/home/clanker_home/bmo-pi/bmo-diy/bmo-face/src
Environment=BMO_SOCKET=/run/bmo/bmo.sock
RuntimeDirectory=bmo
RuntimeDirectoryMode=0770
# Fermare bmo-core (per liberare il microfono, un riavvio) cancellerebbe /run/bmo e con lei il socket
# creato da bmo-face, che resterebbe viva ma muta (la faccia non cambia più: visto il 14/10/2026, #79).
RuntimeDirectoryPreserve=yes
ExecStart=/home/clanker_home/bmo-pi/venv/bin/python -m bmo_face.pannello --assets /home/clanker_home/bmo-pi/bmo-diy/bmo-face/assets --uscita spi
Restart=always
RestartSec=2
MemoryMax=80M

[Install]
WantedBy=multi-user.target
